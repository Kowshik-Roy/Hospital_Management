{
  "name": "carepulse-hospital-management",
  "description": "An enterprise-grade, full-stack Hospital Information System (HIS) with Electronic Medical Records (EMR), Doctor Appointment Booking, Real-Time ICU/CCU Bed Occupancy Tracking, Automated POS Invoicing & Billing, and 24/7 AI Medical Triage Assistant (Bengali & English).",
  "homepage": "https://kowshik-roy.github.io/Hospital_Management/",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"LARAVEL,VITE\" -c \"cyan,magenta\" \"php artisan serve --port=8000\" \"vite\"",
    "build": "vite build && node -e \"const fs=require('fs'); if(fs.existsSync('dist/index.html')){ fs.copyFileSync('dist/index.html', 'dist/404.html'); }\"",
    "serve": "php artisan serve --port=8000",
    "start": "php artisan serve --port=8000",
    "dev:vite": "vite",
    "dev:laravel": "php artisan serve --port=8000",
    "server:node": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "axios": "^1.21.0",
    "concurrently": "^10.0.7",
    "laravel-vite-plugin": "^3.2.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
